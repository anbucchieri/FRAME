		<dynamics damping="${jointDamping}" friction="${jointFriction}"/>
	</joint>
	<joint name="right_ankle_Y" type="revolute">
		<parent link="body_right_ankle"/>
		<child link="right_foot"/>
		<axis xyz="0 1 0"/>
		<origin xyz="0 0 0"/>
		<limit effort="${123*forceCapacity}" lower="-0.66" upper="0.66" velocity="${maxVelJoint}"/>
		<dynamics damping="${jointDamping}" friction="${jointFriction}"/>
	</joint>
	<joint name="left_hip_X" type="revolute">
		<parent link="pelvis"/>
		<child link="body_left_hip_1"/>
		<axis xyz="1 0 0"/>
		<origin xyz="0 ${l_hipWidth} 0"/>
		<limit effort="${108*forceCapacity}" lower="-0.54" upper="0.93" velocity="${maxVelJoint}"/>
		<dynamics damping="${jointDamping}" friction="${jointFriction}"/>
	</joint>
	<joint name="left_hip_Y" type="revolute">
		<parent link="body_left_hip_1"/>
		<child link="body_left_hip_2"/>
		<axis xyz="0 1 0"/>
		<origin xyz="0 0 0"/>
		<limit effort="${186*forceCapacity}" lower="-2.531" upper="0.349" velocity="${maxVelJoint}"/>
		<dynamics damping="${jointDamping}" friction="${jointFriction}"/>
	</joint>
	<joint name="left_hip_Z" type="revolute">
		<parent link="body_left_hip_2"/>
		<child link="left_thigh"/>
		<axis xyz="0 0 1"/>
		<origin xyz="0 0 0"/>
		<limit effort="${67*forceCapacity}" lower="-0.68" upper="0.59" velocity="${maxVelJoint}"/>
		<dynamics damping="${jointDamping}" friction="${jointFriction}"/>
	</joint>
	<joint name="left_knee_Y" type="revolute">
		<parent link="left_thigh"/>
		<child link="body_left_knee"/>
		<axis xyz="0 1 0"/>
		<origin xyz="0 0 ${-l_thigh_length}"/>
		<limit effort="${164*forceCapacity}" lower="-0.087" upper="2.8" velocity="${maxVelJoint}"/>
		<dynamics damping="${jointDamping}" friction="${jointFriction}"/>
	</joint>
	<joint name="left_knee_Z" type="revolute">
		<parent link="body_left_knee"/>
		<child link="left_shank"/>
		<axis xyz="0 0 1"/>
		<origin xyz="0 0 0"/>
		<limit effort="${22*forceCapacity}" lower="-0.61" upper="0.75" velocity="${maxVelJoint}"/>
		<dynamics damping="${jointDamping}" friction="${jointFriction}"/>
	</joint>
	<joint name="left_ankle_X" type="revolute">
		<parent link="left_shank"/>
		<child link="body_left_ankle"/>
		<axis xyz="1 0 0"/>
		<origin xyz="0 0 ${-l_shank_length}"/>
		<limit effort="${29*forceCapacity}" lower="-0.4" upper="0.4" velocity="${maxVelJoint}"/>
		<dynamics damping="${jointDamping}" friction="${jointFriction}"/>
	</joint>
	<joint name="left_ankle_Y" type="revolute">
		<parent link="body_left_ankle"/>
		<child link="left_foot"/>
		<axis xyz="0 1 0"/>
		<origin xyz="0 0 0"/>
		<limit effort="${123*forceCapacity}" lower="-0.66" upper="0.66" velocity="${maxVelJoint}"/>
		<dynamics damping="${jointDamping}" friction="${jointFriction}"/>
	</joint>
	<link name="right_forearm_sensor">
		<inertial>
			<mass value="${massSensor}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="${virtual_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<material name="red"/>
		</visual>
	</link>
	<joint name="J_right_forearm_sensor" type="fixed">
		<parent link="right_forearm"/>
		<child link="right_forearm_sensor"/>
		<origin rpy="${-PI/2} ${-PI/2} 0" xyz="0 ${-2*l_forearm_length/3} 0"/>
	</joint>
	<link name="right_arm_sensor">
		<inertial>
			<mass value="${massSensor}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="${virtual_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<material name="red"/>
		</visual>
	</link>
	<link name="right_forearm_motor">
		<inertial>
			<mass value="${massSensor}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="${virtual_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<material name="red"/>
		</visual>
	</link>
	<joint name="J_right_forearm_motor" type="fixed">
		<parent link="body_right_elbow"/>
		<child link="right_forearm_motor"/>
		<origin rpy="${-PI} 0 0" xyz="0.0 0 0.09"/>
	</joint>
	<link name="right_shoulder_sensor">
		<inertial>
			<mass value="${massSensor}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="${virtual_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<material name="red"/>
		</visual>
	</link>
	<joint name="J_right_arm_sensor" type="fixed">
		<parent link="right_arm"/>
		<child link="right_arm_sensor"/>
		<origin rpy="${-PI/2} ${-PI/2} 0" xyz="0 ${-r_arm_length/2} ${arm_radius}"/>
	</joint>
	<joint name="J_right_shoulder_sensor" type="fixed">
		<parent link="right_arm"/>
		<child link="right_shoulder_sensor"/>
		<origin rpy="${PI} ${PI} ${PI/2}" xyz="0.0 0 ${arm_radius+0.05}"/>
	</joint>
	<link name="left_forearm_sensor">
		<inertial>
			<mass value="${massSensor}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="${virtual_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<material name="red"/>
		</visual>
	</link>
	<joint name="J_left_forearm_sensor" type="fixed">
		<parent link="left_forearm"/>
		<child link="left_forearm_sensor"/>
		<origin rpy="${PI/2} 0 0" xyz="0 ${2*l_forearm_length/3} 0"/>
	</joint>
	<link name="left_arm_sensor">
		<inertial>
			<mass value="${massSensor}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="${virtual_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<material name="red"/>
		</visual>
	</link>
	<joint name="J_left_arm_sensor" type="fixed">
		<parent link="left_arm"/>
		<child link="left_arm_sensor"/>
		<origin rpy="${-PI/2} ${-PI/2} 0" xyz="0 ${r_arm_length/2} ${arm_radius}"/>
	</joint>
	<link name="left_shoulder_sensor">
		<inertial>
			<mass value="${massSensor}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="${virtual_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<material name="red"/>
		</visual>
	</link>
	<joint name="J_left_shoulder_sensor" type="fixed">
		<parent link="left_arm"/>
		<child link="left_shoulder_sensor"/>
		<origin rpy="0 0 ${PI/2}" xyz="0 0 ${arm_radius+0.05}"/>
	</joint>
	<link name="thoracic_sensor">
		<inertial>
			<mass value="${massSensor}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="${virtual_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="${-thoracicspine_depth/4} 0 ${thoracicspine_length/2}"/>
			<material name="red"/>
		</visual>
	</link>
	<joint name="J_thoracic_sensor" type="fixed">
		<parent link="thoracic_spine"/>
		<child link="thoracic_sensor"/>
		<origin rpy="0 0 0 " xyz="${-thoracicspine_depth/4} 0 ${thoracicspine_length/2}"/>
	</joint>
	<link name="pelvis_sensor">
		<inertial>
			<mass value="${massSensor}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="${virtual_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="${-pelvis_depth/4} 0 ${pelvis_length/2}"/>
			<material name="red"/>
		</visual>
	</link>
	<joint name="J_pelvis_sensor" type="fixed">
		<parent link="pelvis"/>
		<child link="pelvis_sensor"/>
		<origin rpy="0 0 0 " xyz="${-pelvis_depth/4} 0 0"/>
	</joint>
</robot>
