<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dhm">
	<xacro:property name="bodyHeight" value="1.9"/>
	<xacro:property name="BMI" value="29.91689750692521"/>
	<xacro:property name="isBMIgreaterThanAverage" value="0"/>
	<xacro:property name="PI" value="3.1415926535897931"/>
	<xacro:property name="bodyMass" value="108"/>
	<xacro:property name="maxVelJoint" value="10.0"/>
	<xacro:property name="forceCapacity" value="1.0"/>
	<xacro:property name="jointDamping" value="0.1"/>
	<xacro:property name="jointFriction" value="0."/>
	<xacro:property name="S5_L5" value="0.108316"/>
	<xacro:property name="L5_T8" value="0.341289"/>
	<xacro:property name="T8_C7" value="0.154148"/>
	<xacro:property name="C7_C1" value="0.102566"/>
	<xacro:property name="C1_headtop" value="0.190476"/>
	<xacro:property name="head_radius" value="0.10656600000000001"/>
	<xacro:property name="headbase_headtop" value="${1.1*C1_headtop}"/>
	<xacro:property name="r_armLength" value="0.331994"/>
	<xacro:property name="r_forearmLength" value="0.271576"/>
	<xacro:property name="r_handLength" value="0.20327"/>
	<xacro:property name="r_spine_shoulder" value="0.18906"/>
	<xacro:property name="r_T8_CSJheight" value="0.086386"/>
	<xacro:property name="r_spine_CSJ" value="0.033455"/>
	<xacro:property name="r_shoulderWidth" value="0.155605"/>
	<xacro:property name="l_armLength" value="0.331994"/>
	<xacro:property name="l_forearmLength" value="0.271576"/>
	<xacro:property name="l_handLength" value="0.20327"/>
	<xacro:property name="l_spine_shoulder" value="0.18906"/>
	<xacro:property name="l_T8_CSJheight" value="0.086386"/>
	<xacro:property name="l_spine_CSJ" value="0.033455"/>
	<xacro:property name="l_shoulderWidth" value="0.155605"/>
	<xacro:property name="r_hipWidth" value="0.088907"/>
	<xacro:property name="r_legLength" value="0.460135"/>
	<xacro:property name="r_shankLength" value="0.450138"/>
	<xacro:property name="r_footThickness" value="0.097768"/>
	<xacro:property name="r_footFrontLength" value="0.25538700000000003"/>
	<xacro:property name="r_footRearLength" value="0.044611"/>
	<xacro:property name="l_hipWidth" value="0.088907"/>
	<xacro:property name="l_legLength" value="0.460135"/>
	<xacro:property name="l_shankLength" value="0.450138"/>
	<xacro:property name="l_footThickness" value="0.097768"/>
	<xacro:property name="l_footFrontLength" value="0.25538700000000003"/>
	<xacro:property name="l_footRearLength" value="0.044611"/>
	<xacro:property name="slimBMI" value="17"/>
	<xacro:property name="normBMI" value="22"/>
	<xacro:property name="fatBMI" value="40"/>
	<xacro:property name="slimAlpha" value="0.9"/>
	<xacro:property name="normAlpha" value="1.0"/>
	<xacro:property name="fatAlpha" value="1.3"/>
	<xacro:if value="${isBMIgreaterThanAverage == 1}">
		<xacro:property name="alpha" value="${1 + (fatAlpha  - normAlpha) * (BMI - normBMI) / (fatBMI - normBMI)}"/>
	</xacro:if>
	<xacro:if value="${isBMIgreaterThanAverage == 0}">
		<xacro:property name="alpha" value="${1 - (normAlpha - slimAlpha) * (normBMI - BMI) / (normBMI - slimBMI)}"/>
	</xacro:if>
	<xacro:property name="collision_width_factor" value="0.66"/>
	<xacro:property name="collision_height_factor" value="0.95"/>
	<xacro:property name="collision_depth_factor" value="0.66"/>
	<xacro:property name="hip_thickness" value="${alpha*0.08}"/>
	<xacro:property name="pelvis_length" value="${S5_L5 + hip_thickness}"/>
	<xacro:property name="pelvis_width" value="${r_hipWidth + l_hipWidth + 0.7*hip_thickness + alpha*0.11}"/>
	<xacro:property name="pelvis_depth" value="${2*alpha*0.11}"/>
	<xacro:property name="lumbarspine_length" value="${L5_T8}"/>
	<xacro:property name="lumbarspine_width" value="${r_hipWidth + l_hipWidth + alpha*0.105}"/>
	<xacro:property name="lumbarspine_depth" value="${2*alpha*0.105}"/>
	<xacro:property name="thoracicspine_length" value="${T8_C7}"/>
	<xacro:property name="thoracicspine_width" value="${0.7*(r_spine_shoulder + l_spine_shoulder) +alpha*0.10}"/>
	<xacro:property name="thoracicspine_depth" value="${2*alpha*0.10}"/>
	<xacro:property name="neck_length" value="${C7_C1}"/>
	<xacro:property name="neck_radius" value="${alpha*0.045}"/>
	<xacro:property name="head_length" value="${headbase_headtop}"/>
	<xacro:property name="r_clavicular_length" value="${r_shoulderWidth}"/>
	<xacro:property name="l_clavicular_length" value="${l_shoulderWidth}"/>
	<xacro:property name="clavicular_radius" value="${alpha*0.06}"/>
	<xacro:property name="r_arm_length" value="${r_armLength}"/>
	<xacro:property name="l_arm_length" value="${l_armLength}"/>
	<xacro:property name="arm_radius" value="${alpha*0.05}"/>
	<xacro:property name="r_forearm_length" value="${r_forearmLength}"/>
	<xacro:property name="l_forearm_length" value="${l_forearmLength}"/>
	<xacro:property name="forearm_radius" value="${alpha*0.04}"/>
	<xacro:property name="r_palm_length" value="${0.5*r_handLength}"/>
	<xacro:property name="l_palm_length" value="${0.5*l_handLength}"/>
	<xacro:property name="palm_width" value="${2*alpha*0.04}"/>
	<xacro:property name="palm_depth" value="${2*alpha*0.015}"/>
	<xacro:property name="r_fingers_length" value="${0.5*r_handLength}"/>
	<xacro:property name="l_fingers_length" value="${0.5*l_handLength}"/>
	<xacro:property name="fingers_width" value="${palm_width}"/>
	<xacro:property name="fingers_depth" value="${palm_depth}"/>
	<xacro:property name="r_thigh_length" value="${r_legLength}"/>
	<xacro:property name="l_thigh_length" value="${l_legLength}"/>
	<xacro:property name="thigh_radius" value="${alpha*0.08}"/>
	<xacro:property name="r_shank_length" value="${r_shankLength}"/>
	<xacro:property name="l_shank_length" value="${l_shankLength}"/>
	<xacro:property name="shank_radius" value="${alpha*0.06}"/>
	<xacro:property name="r_foot_length" value="${r_footFrontLength + r_footRearLength}"/>
	<xacro:property name="l_foot_length" value="${l_footFrontLength + l_footRearLength}"/>
	<xacro:property name="r_foot_width" value="${0.4*r_foot_length}"/>
	<xacro:property name="l_foot_width" value="${0.4*l_foot_length}"/>
	<xacro:property name="r_foot_depth" value="${r_footThickness}"/>
	<xacro:property name="l_foot_depth" value="${l_footThickness}"/>
	<xacro:property name="massNorm" value="${-0.0426 + 1.00096*bodyMass + 0.00058*bodyHeight*100}"/>
	<xacro:property name="lowertorso_mass" value="${bodyMass * (-7.498 + 0.0976*bodyMass + 0.04896*bodyHeight*100) / massNorm}"/>
	<xacro:property name="middletorso_mass" value="${bodyMass * (7.181 + 0.2234*bodyMass - 0.0663*bodyHeight*100) / massNorm}"/>
	<xacro:property name="uppertorso_mass" value="${bodyMass * (8.2144 + 0.1862*bodyMass - 0.0584*bodyHeight*100) / massNorm}"/>
	<xacro:property name="pelvis_mass" value="${lowertorso_mass}"/>
	<xacro:property name="lumbarspine_mass" value="${middletorso_mass}"/>
	<xacro:property name="thoracicspine_mass" value="${(1.0-0.1)*uppertorso_mass}"/>
	<xacro:property name="neckandhead_mass" value="${bodyMass * (1.296 + 0.0171*bodyMass + 0.0143*bodyHeight*100) / massNorm}"/>
	<xacro:property name="neck_mass" value="${0.1*neckandhead_mass}"/>
	<xacro:property name="head_mass" value="${0.9*neckandhead_mass}"/>
	<xacro:property name="clavicular_mass" value="${0.05*uppertorso_mass}"/>
	<xacro:property name="arm_mass" value="${bodyMass * (0.25 + 0.03012*bodyMass - 0.0027*bodyHeight*100) / massNorm}"/>
	<xacro:property name="forearm_mass" value="${bodyMass * (0.3185 + 0.01445*bodyMass - 0.00114*bodyHeight*100) / massNorm}"/>
	<xacro:property name="hand_mass" value="${bodyMass * (-0.1165 + 0.0036*bodyMass + 0.00175*bodyHeight*100) / massNorm}"/>
	<xacro:property name="palm_mass" value="${0.7*hand_mass}"/>
	<xacro:property name="fingers_mass" value="${0.3*hand_mass}"/>
	<xacro:property name="thigh_mass" value="${bodyMass * (-2.649 + 0.1463*bodyMass + 0.0137*bodyHeight*100) / massNorm}"/>
	<xacro:property name="shank_mass" value="${bodyMass * (-1.592 + 0.03616*bodyMass + 0.0121*bodyHeight*100) / massNorm}"/>
	<xacro:property name="foot_mass" value="${bodyMass * (-0.829 + 0.0077*bodyMass + 0.0073*bodyHeight*100) / massNorm}"/>
	<xacro:property name="massSensor" value="0.000000001"/>
	<xacro:property name="radius_load" value="0.05"/>
	<xacro:property name="length_load" value="0.15"/>
	<xacro:property name="mass_load" value="0.780"/>
	<xacro:macro name="box_inertia" params="m Lx Ly Lz">
		<inertia ixx="${1/12 * m * (Ly*Ly + Lz*Lz)}" ixy="0" ixz="0" iyy="${1/12 * m * (Lx*Lx + Lz*Lz)}" iyz="0" izz="${1/12 * m * (Lx*Lx + Ly*Ly)}"/>
	</xacro:macro>
	<xacro:macro name="cylinder_inertia" params="m L r">
		<inertia ixx="${1/12 * m * (3*r*r + L*L)}" ixy="0" ixz="0" iyy="${1/12 * m * (3*r*r + L*L)}" iyz="0" izz="${1/2 * m * r*r}"/>
	</xacro:macro>
	<xacro:macro name="sphere_inertia" params="m r">
		<inertia ixx="${2/5 * m * r*r}" ixy="0" ixz="0" iyy="${2/5 * m * r*r}" iyz="0" izz="${2/5 * m * r*r}"/>
	</xacro:macro>
	<xacro:property name="virtual_radius" value="0.001"/>
	<xacro:macro name="virtual_body" params="name m">
		<link name="${name}">
			<inertial>
				<mass value="${m}"/>
				<origin rpy="0 0 0" xyz="0 0 0"/>
				<sphere_inertia m="${m}" r="${virtual_radius}"/>
			</inertial>
		</link>
	</xacro:macro>
	<material name="blue">
		<color rgba="0 0 0.8 1"/>
	</material>
	<material name="red">
		<color rgba="0.8 0 0 1"/>
	</material>
	<link name="pelvis">
		<visual>
			<geometry>
				<box size="${pelvis_depth} ${pelvis_width} ${pelvis_length}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${pelvis_length/2-hip_thickness}"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${pelvis_depth} ${pelvis_width} ${pelvis_length}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${pelvis_length/2-hip_thickness}"/>
		</collision>
		<inertial>
			<mass value="${0.7*pelvis_mass}"/>
			<origin rpy="0 0 0" xyz="0 0 ${pelvis_length/2-hip_thickness}"/>
			<box_inertia Lx="${pelvis_depth}" Ly="${pelvis_width}" Lz="${pelvis_length}" m="${0.7*pelvis_mass}"/>
		</inertial>
	</link>
	<virtual_body m="${0.1*pelvis_mass}" name="body_L5_1"/>
	<virtual_body m="${0.1*lumbarspine_mass}" name="body_L5_2"/>
	<link name="lumbar_spine">
		<visual>
			<geometry>
				<box size="${lumbarspine_depth} ${lumbarspine_width} ${lumbarspine_length}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${lumbarspine_length/2}"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${lumbarspine_depth} ${lumbarspine_width} ${lumbarspine_length}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${lumbarspine_length/2}"/>
		</collision>
		<inertial>
			<mass value="${0.8*lumbarspine_mass}"/>
			<origin rpy="0 0 0" xyz="0 0 ${lumbarspine_length/2}"/>
			<box_inertia Lx="${lumbarspine_depth}" Ly="${lumbarspine_width}" Lz="${lumbarspine_length}" m="${0.8*lumbarspine_mass}"/>
		</inertial>
	</link>
	<virtual_body m="${0.1*lumbarspine_mass}" name="body_T8_1"/>
	<virtual_body m="${0.1*thoracicspine_mass}" name="body_T8_2"/>
	<link name="thoracic_spine">
		<visual>
			<geometry>
				<box size="${thoracicspine_depth} ${thoracicspine_width} ${thoracicspine_length}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${thoracicspine_length/2}"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${thoracicspine_depth} ${thoracicspine_width} ${thoracicspine_length}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${thoracicspine_length/2}"/>
		</collision>
		<inertial>
			<mass value="${0.65*thoracicspine_mass}"/>
			<origin rpy="0 0 0" xyz="0 0 ${thoracicspine_length/2}"/>
			<box_inertia Lx="${thoracicspine_depth}" Ly="${thoracicspine_width}" Lz="${thoracicspine_length}" m="${0.65*thoracicspine_mass}"/>
		</inertial>
	</link>
	<virtual_body m="${0.05*thoracicspine_mass}" name="body_C7_1"/>
	<virtual_body m="${0.2*neck_mass}" name="body_C7_2"/>
	<link name="neck">
		<visual>
			<geometry>
				<cylinder length="${neck_length}" radius="${neck_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${neck_length/2}"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${neck_radius*2} ${neck_radius*2} ${neck_length}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${neck_length/2}"/>
		</collision>
		<inertial>
			<mass value="${0.8*neck_mass}"/>
			<origin rpy="0 0 0" xyz="0 0 ${neck_length/2}"/>
			<cylinder_inertia L="${neck_length}" m="${0.8*neck_mass}" r="${neck_radius}"/>
		</inertial>
	</link>
	<virtual_body m="${0.1*head_mass}" name="body_C1"/>
	<link name="head">
		<visual>
			<geometry>
				<sphere radius="${head_radius}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${C1_headtop - headbase_headtop/2}"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<sphere radius="${head_radius*0.8}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 ${C1_headtop - headbase_headtop/2}"/>
		</collision>
		<inertial>
			<mass value="${0.9*head_mass}"/>
			<origin rpy="0 0 0" xyz="0 0 ${C1_headtop - headbase_headtop/2}"/>
			<cylinder_inertia L="${head_length}" m="${0.9*head_mass}" r="${head_radius}"/>
		</inertial>
	</link>
	<virtual_body m="${0.1*thoracicspine_mass}" name="body_T4_right_clavicular"/>
	<link name="right_clavicular">
		<visual>
			<geometry>
				<cylinder length="${r_clavicular_length}" radius="${clavicular_radius}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_clavicular_length/2} 0"/>
			<material name="blue"/>
		</visual>
		<inertial>
			<mass value="${0.9*clavicular_mass}"/>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_clavicular_length/2} 0"/>
			<cylinder_inertia L="${r_clavicular_length}" m="${0.9*clavicular_mass}" r="${clavicular_radius}"/>
		</inertial>
	</link>
	<virtual_body m="${0.1*clavicular_mass}" name="body_right_shoulder_1"/>
	<virtual_body m="${0.1*arm_mass}" name="body_right_shoulder_2"/>
	<link name="right_arm">
		<visual>
			<geometry>
				<cylinder length="${r_arm_length}" radius="${arm_radius}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_arm_length/2} 0"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${arm_radius*cos(PI/4)*2} ${arm_radius*cos(PI/4)*2} ${r_arm_length}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_arm_length/2} 0"/>
		</collision>
		<inertial>
			<mass value="${0.8*arm_mass}"/>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_arm_length/2} 0"/>
			<cylinder_inertia L="${r_arm_length}" m="${0.8*arm_mass}" r="${arm_radius}"/>
		</inertial>
	</link>
	<virtual_body m="${0.1*arm_mass}" name="body_right_elbow"/>
	<link name="right_forearm">
		<visual>
			<geometry>
				<cylinder length="${r_forearm_length}" radius="${forearm_radius}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_forearm_length/2} 0"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${forearm_radius*cos(PI/4)*2} ${forearm_radius*cos(PI/4)*2} ${r_forearm_length}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_forearm_length/2} 0"/>
		</collision>
		<inertial>
			<mass value="${0.9*forearm_mass}"/>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_forearm_length/2} 0"/>
			<cylinder_inertia L="${-r_forearm_length}" m="${0.9*forearm_mass}" r="${forearm_radius}"/>
		</inertial>
	</link>
	<virtual_body m="${0.1*forearm_mass}" name="body_right_wrist"/>
	<link name="right_palm">
		<visual>
			<geometry>
				<box size="${palm_width} ${palm_depth} ${r_palm_length}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_palm_length/2} 0"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${palm_width} ${palm_depth} ${r_palm_length} "/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_palm_length/2} 0"/>
		</collision>
		<inertial>
			<mass value="${palm_mass}"/>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_palm_length/2} 0"/>
			<box_inertia Lx="${palm_width}" Ly="${palm_depth}" Lz="${r_palm_length}" m="${palm_mass}"/>
		</inertial>
	</link>
	<link name="right_fingers">
		<visual>
			<geometry>
				<box size="${fingers_width} ${fingers_depth} ${r_fingers_length}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_fingers_length/2} 0"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${fingers_width} ${fingers_depth} ${r_fingers_length} "/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_fingers_length/2} 0"/>
		</collision>
		<inertial>
			<mass value="${fingers_mass}"/>
			<origin rpy="${PI/2} 0 0" xyz="0 ${-r_fingers_length/2} 0"/>
			<box_inertia Lx="${fingers_width}" Ly="${fingers_depth}" Lz="${r_fingers_length}" m="${fingers_mass}"/>
		</inertial>
	</link>
	<link name="right_load">
		<visual>
			<geometry>
				<cylinder length="${length_load}" radius="${radius_load}"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<material name="red"/>
		</visual>
		<inertial>
			<mass value="${mass_load}"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<cylinder_inertia L="${length_load}" m="${mass_load}" r="${radius_load}"/>
		</inertial>
	</link>
	<virtual_body m="${0.1*thoracicspine_mass}" name="body_T4_left_clavicular"/>
	<link name="left_clavicular">
		<visual>
			<geometry>
				<cylinder length="${l_clavicular_length}" radius="${clavicular_radius}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${l_clavicular_length/2} 0"/>
			<material name="blue"/>
		</visual>
		<inertial>
			<mass value="${0.9*clavicular_mass}"/>
			<origin rpy="${PI/2} 0 0" xyz="0 ${l_clavicular_length/2} 0"/>
			<cylinder_inertia L="${l_clavicular_length}" m="${0.9*clavicular_mass}" r="${clavicular_radius}"/>
		</inertial>
	</link>
	<virtual_body m="${0.1*clavicular_mass}" name="body_left_shoulder_1"/>
	<virtual_body m="${0.1*arm_mass}" name="body_left_shoulder_2"/>
	<link name="left_arm">
		<visual>
			<geometry>
				<cylinder length="${l_arm_length}" radius="${arm_radius}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${l_arm_length/2} 0"/>
			<material name="blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${arm_radius*cos(PI/4)*2} ${arm_radius*cos(PI/4)*2} ${l_arm_length}"/>
			</geometry>
			<origin rpy="${PI/2} 0 0" xyz="0 ${l_arm_length/2} 0"/>
		</collision>
		<inertial>
			<mass value="${0.8*arm_mass}"/>
			<origin rpy="${PI/2} 0 0" xyz="0 ${l_arm_length/2} 0"/>
			&gt;
			<cylinder_inertia L="${l_arm_length}" m="${0.8*arm_mass}" r="${arm_radius}"/>
		</inertial>
	</link>
